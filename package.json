{
    "name": "galaguerre",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "license": "UNLICENSED",
    "scripts": {
        "start": "node bin/server.js",
        "build": "node ace build && yarn zip",
        "zip": "bash ./zipping.sh",
        "dev": "node ace serve --watch",
        "test": "node ace test",
        "format": "biome format --write",
        "format-check": "biome format",
        "lint": "biome lint --write",
        "lint-check": "biome lint",
        "typecheck": "tsc --noEmit",
        "frontend-typecheck": "cd frontend && yarn tsc --noEmit --project tsconfig.json"
    },
    "imports": {
        "#adomin/*": "./app/adomin/*.js",
        "#api_types/*": "./api_types/*.js",
        "#controllers/*": "./app/controllers/*.js",
        "#exceptions/*": "./app/exceptions/*.js",
        "#models/*": "./app/models/*.js",
        "#mails/*": "./app/mails/*.js",
        "#services/*": "./app/services/*.js",
        "#listeners/*": "./app/listeners/*.js",
        "#events/*": "./app/events/*.js",
        "#middleware/*": "./app/middleware/*.js",
        "#validators/*": "./app/validators/*.js",
        "#providers/*": "./providers/*.js",
        "#policies/*": "./app/policies/*.js",
        "#abilities/*": "./app/abilities/*.js",
        "#database/*": "./database/*.js",
        "#start/*": "./start/*.js",
        "#tests/*": "./tests/*.js",
        "#config/*": "./config/*.js",
        "#generated/*": "./.adonisjs/server/*.js",
        "#transformers/*": "./app/transformers/*.js"
    },
    "devDependencies": {
        "@adonisjs/assembler": "^8.4.0",
        "@adonisjs/tsconfig": "^2.0.0",
        "@biomejs/biome": "1.8.3",
        "@galadrim/galacrypt": "^2.0.0",
        "@japa/api-client": "^3.2.1",
        "@japa/assert": "^4.2.0",
        "@japa/plugin-adonisjs": "^5.2.0",
        "@japa/runner": "^5.3.0",
        "@mantine/core": "^7.12.1",
        "@mantine/hooks": "^7.12.1",
        "@poppinss/ts-exec": "^1.4.4",
        "@tabler/icons-react": "^3.44.0",
        "@tanstack/react-query": "^5.101.0",
        "@types/luxon": "^3.4.2",
        "@types/node": "^24",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.5.0",
        "clsx": "^2.1.1",
        "hot-hook": "^0.2.6",
        "mobx": "^6.16.0",
        "mobx-react-lite": "^4.1.1",
        "pino-pretty": "^13.1.3",
        "postcss": "^8.5.15",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.17.0",
        "react-toastify": "^11.1.0",
        "socket.io-client": "^4.8.3",
        "tailwindcss": "^3.4.10",
        "typescript": "^5.9",
        "vite": "^7.0.0",
        "youch": "^4.1.1",
        "zod": "^3.23.8"
    },
    "dependencies": {
        "@adonisjs/auth": "^10.1.0",
        "@adonisjs/core": "^7.3.4",
        "@adonisjs/cors": "^3.0.0",
        "@adonisjs/lucid": "^22.4.2",
        "@adonisjs/static": "^2.0.1",
        "@adonisjs/vite": "^5.1.1",
        "@softwaretechnik/dbml-renderer": "^1.0.30",
        "@vinejs/vine": "^4.4.0",
        "axios": "^1.17.0",
        "edge.js": "^6.5.1",
        "luxon": "^3.4.4",
        "pg": "^8.12.0",
        "reflect-metadata": "^0.2.2",
        "socket.io": "^4.8.3",
        "xlsx": "^0.18.5"
    },
    "hotHook": {
        "boundaries": [
            "./app/controllers/**/*.ts",
            "./app/middleware/*.ts"
        ]
    },
    "packageManager": "yarn@4.2.2",
    "volta": {
        "node": "24.11.0",
        "yarn": "4.2.2"
    }
}
